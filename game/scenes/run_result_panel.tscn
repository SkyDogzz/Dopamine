[gd_scene load_steps=3 format=3]

[ext_resource type="Theme" path="res://themes/dopamine_ui.tres" id="1_theme"]
[ext_resource type="Script" path="res://scripts/run_result_panel.gd" id="2_script"]

[node name="RunResultPanel" type="PanelContainer"]
custom_minimum_size = Vector2(280, 200)
theme = ExtResource("1_theme")
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 10
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 10
script = ExtResource("2_script")

[node name="Content" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 6
alignment = 1

[node name="Title" type="Label" parent="Content"]
layout_mode = 2
theme_type_variation = "PixelHeading"
theme_override_font_sizes/font_size = 16
text = "RUN OVER"
horizontal_alignment = 1

[node name="Summary" type="Label" parent="Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.647059, 0.682353, 0.764706, 1)
theme_override_font_sizes/font_size = 8
text = "WAVE 01  •  00:00  •  0 KILLS"
horizontal_alignment = 1

[node name="Divider" type="HSeparator" parent="Content"]
layout_mode = 2

[node name="Rewards" type="Label" parent="Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.215686, 0.909804, 0.960784, 1)
theme_override_font_sizes/font_size = 8
text = "NO PROFILE ATTACHED"
horizontal_alignment = 1

[node name="Achievement" type="Label" parent="Content"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.831373, 0.278431, 1)
theme_override_font_sizes/font_size = 8
text = ""
horizontal_alignment = 1

[node name="Equipment" type="Label" parent="Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.647059, 0.682353, 0.764706, 1)
theme_override_font_sizes/font_size = 8
text = ""
autowrap_mode = 3
horizontal_alignment = 1

[node name="RestartButton" type="Button" parent="Content"]
custom_minimum_size = Vector2(0, 27)
layout_mode = 2
text = "RUN AGAIN  →"

[node name="QuitButton" type="Button" parent="Content"]
custom_minimum_size = Vector2(0, 27)
layout_mode = 2
text = "QUIT TO MENU"
