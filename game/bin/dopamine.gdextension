[configuration]

entry_symbol = "dopamine_library_init"
compatibility_minimum = "4.7"

[libraries]

windows.debug.x86_64 = "res://bin/windows/libdopamine.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/windows/libdopamine.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://bin/linux/libdopamine.linux.template_debug.x86_64.so"
