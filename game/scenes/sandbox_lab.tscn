[gd_scene load_steps=4 format=3]

[ext_resource type="Theme" path="res://themes/dopamine_ui.tres" id="1_theme"]
[ext_resource type="Script" path="res://scripts/sandbox_lab.gd" id="2_script"]
[ext_resource type="Script" path="res://scripts/simulation_view.gd" id="3_view"]

[node name="SandboxLab" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("1_theme")
script = ExtResource("2_script")

[node name="Root" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 10.0
offset_top = 8.0
offset_right = -10.0
offset_bottom = -8.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 5

[node name="PresetFileDialog" type="FileDialog" parent="."]
title = "Open Sandbox preset"
size = Vector2i(680, 420)
ok_button_text = "OPEN"
file_mode = 0
access = 2
filters = PackedStringArray("*.json ; Sandbox preset JSON")

[node name="Header" type="HBoxContainer" parent="Root"]
layout_mode = 2

[node name="Title" type="Label" parent="Root/Header"]
