[gd_scene load_steps=3 format=3]

[ext_resource type="Theme" path="res://themes/dopamine_ui.tres" id="1_theme"]
[ext_resource type="Script" path="res://scripts/chest_choice.gd" id="2_script"]

[node name="ChestChoice" type="PanelContainer"]
custom_minimum_size = Vector2(310, 215)
theme = ExtResource("1_theme")
theme_override_constants/margin_left = 10
theme_override_constants/margin_top = 8
theme_override_constants/margin_right = 10
theme_override_constants/margin_bottom = 8
script = ExtResource("2_script")

[node name="Content" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Title" type="Label" parent="Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.215686, 0.909804, 0.960784, 1)
theme_override_font_sizes/font_size = 11
text = "CHEST — CHOOSE ONE"
horizontal_alignment = 1

[node name="Instruction" type="Label" parent="Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.647059, 0.682353, 0.764706, 1)
theme_override_font_sizes/font_size = 8
text = "SELECT ONE UPGRADE TO CONTINUE"
horizontal_alignment = 1

[node name="Options" type="VBoxContainer" parent="Content"]
layout_mode = 2
theme_override_constants/separation = 5
